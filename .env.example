# Copy to .env and replace every placeholder with a newly generated key.
# This file is safe to commit; .env is ignored.
V_EVAL_CHECKLIST_URL=https://api.example.com/v1
V_EVAL_CHECKLIST_MODEL=your-checklist-model
V_EVAL_CHECKLIST_API_KEY=replace-with-new-key

V_EVAL_VISION_JUDGE_URL=https://api.example.com/v1
V_EVAL_VISION_JUDGE_MODEL=your-vision-model
V_EVAL_VISION_JUDGE_API_KEY=replace-with-new-key

V_EVAL_AUDIO_JUDGE_URL=https://api.example.com/v1
V_EVAL_AUDIO_JUDGE_MODEL=your-audio-model
V_EVAL_AUDIO_JUDGE_API_KEY=replace-with-new-key

# Optional D16 real SyncNet v2 adapter. Leave unset to use checklist-only fallback.
# V_EVAL_SYNCNET_COMMAND=python3 /path/to/syncnet_adapter.py
# V_EVAL_SYNCNET_WEIGHTS=/path/to/syncnet_v2.model
# V_EVAL_SYNCNET_MAX_WINDOWS=4
# V_EVAL_SYNCNET_MAX_TOTAL_SECONDS=12
# V_EVAL_D16_MAX_WINDOWS=4
# V_EVAL_D16_MAX_TOTAL_SECONDS=12
